<%- include('partials/head', { title: title, active: 'home' }) %>
<div class="container">
  <nav class="breadcrumb" aria-label="Brotkrumen">
    <a href="<%= homeUrl %>">Kollektion</a>
    <% if (product.category) { %><span aria-hidden="true">›</span><a href="<%= homeUrl %>?kategorie=<%= encodeURIComponent(product.category) %>#kollektion"><%= product.category %></a><% } %>
    <span aria-hidden="true">›</span><span><%= product.name %></span>
  </nav>

  <% if (query.hinzugefuegt) { %>
    <div class="added-box">
      <span>✓ Im Warenkorb. Möchtest du noch etwas bestellen?</span>
      <span class="added-actions">
        <a class="btn btn-outline btn-sm" href="<%= homeUrl %>#kollektion">Weiter einkaufen</a>
        <a class="btn btn-primary btn-sm" href="<%= base %>/warenkorb">Zum Warenkorb</a>
      </span>
    </div>
  <% } %>

  <div class="product-detail">
    <div class="product-gallery">
      <div class="product-image-frame">
        <img id="product-image" src="<%= h.productImage(product, selectedColor) %>" alt="<%= product.name %><%= selectedColor ? ' in ' + selectedColor.name : '' %>" width="600" height="600">
        <% if (badge) { %><span class="funding-badge funding-badge-lg"><%= badge %></span><% } %>
      </div>
      <% if (product.logo_print) { %>
        <p class="logo-print-note">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.9-4.9 1.4 1.4-6.3 6.3Z"/></svg>
          inkl. <%= product.logo_print %>
        </p>
      <% } %>
    </div>

    <div class="product-info">
      <% if (product.brand) { %><p class="product-brand"><%= product.brand %></p><% } %>
      <h1 class="product-title"><%= product.name %></h1>
      <% if (product.sku) { %><p class="muted small">Artikelnummer: <%= product.sku %></p><% } %>

      <div class="price-headline">
        <span class="price-main<%= unit.memberCents === 0 ? ' price-free' : '' %>" data-price-member><%= unit.memberCents === 0 ? 'Kostenlos' : h.money(unit.memberCents) + '*' %></span>
        <% if (product.uvp_cents && product.uvp_cents > unit.articleCents) { %><span class="price-uvp">UVP <s><%= h.money(product.uvp_cents) %></s></span><% } %>
      </div>

      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

      <form class="product-form" method="post" action="<%= base %>/warenkorb/add" data-product-form>
        <input type="hidden" name="productId" value="<%= product.id %>">
        <script type="application/json" id="product-data"><%- productJson %></script>

        <% if (product.variants.length) { %>
          <fieldset class="option-group">
            <legend>Ausführung</legend>
            <div class="pill-options">
              <% product.variants.forEach(function (v, i) { var price = (v.price_cents != null && v.price_cents !== '') ? v.price_cents : product.price_cents; %>
                <label class="pill-option">
                  <input type="radio" name="variant" value="<%= v.name %>" <%= values.variant === v.name ? 'checked' : '' %> required>
                  <span><%= v.name %> <small><%= h.money(price) %></small></span>
                </label>
              <% }) %>
            </div>
          </fieldset>
        <% } %>

        <% if (product.colors.length) { %>
          <fieldset class="option-group">
            <legend>Farbe: <strong data-color-name><%= values.color %></strong></legend>
            <div class="swatch-options">
              <% product.colors.forEach(function (c) { %>
                <label class="swatch-option" title="<%= c.name %>">
                  <input type="radio" name="color" value="<%= c.name %>" <%= values.color === c.name ? 'checked' : '' %> required>
                  <span class="swatch" style="--c1: <%= c.hex %>; --c2: <%= c.hex2 || c.hex %>"></span>
                  <span class="visually-hidden"><%= c.name %></span>
                </label>
              <% }) %>
            </div>
          </fieldset>
        <% } %>

        <% if (product.sizes.length) { %>
          <fieldset class="option-group">
            <legend>Größe</legend>
            <div class="pill-options size-options">
              <% product.sizes.forEach(function (s) { %>
                <label class="pill-option">
                  <input type="radio" name="size" value="<%= s %>" <%= values.size === s ? 'checked' : '' %> required>
                  <span><%= s %></span>
                </label>
              <% }) %>
            </div>
            <% var sizePage = navPages.concat(footerPages).find(function (p) { return /gr(oe|ö)ss?e/.test(p.slug); }); if (sizePage) { %>
              <a class="small size-link" href="<%= base %>/seite/<%= sizePage.slug %>" target="_blank" rel="noopener">Größentabelle ansehen</a>
            <% } %>
          </fieldset>
        <% } %>

        <% if (product.print_options.length) { %>
          <fieldset class="option-group print-group">
            <legend>Persönlicher Druck <span class="muted">(optional)</span></legend>
            <% product.print_options.forEach(function (o) { var val = (values.prints && values.prints[o.key]) || ''; %>
              <label class="field">
                <span class="field-label"><%= o.label %> <span class="muted">+ <%= h.money(o.price_cents) %><% if (o.required) { %> · Pflichtfeld<% } %></span></span>
                <input type="text" name="prints[<%= o.key %>]" value="<%= val %>" <% if (o.max_length) { %>maxlength="<%= o.max_length %>"<% } %> placeholder="<%= o.placeholder || '' %>" data-print-key="<%= o.key %>" <%= o.required ? 'required' : '' %> autocomplete="off">
                <% if (o.max_length) { %><span class="hint"><span data-count-for="<%= o.key %>"><%= val.length %></span>/<%= o.max_length %> Zeichen</span><% } %>
              </label>
            <% }) %>
          </fieldset>
        <% } %>

        <div class="option-group qty-group">
          <label for="qty" class="option-label">Menge</label>
          <div class="qty-control">
            <button type="button" class="qty-btn" data-qty="-1" aria-label="Menge verringern">−</button>
            <input id="qty" type="number" name="quantity" min="1" max="99" value="<%= values.quantity || 1 %>" inputmode="numeric">
            <button type="button" class="qty-btn" data-qty="1" aria-label="Menge erhöhen">+</button>
          </div>
        </div>

        <div class="price-breakdown" aria-live="polite">
          <div><span>Artikelpreis</span><span data-price-article><%= h.money(unit.articleCents) %></span></div>
          <div class="pb-club" <%= unit.clubCents ? '' : 'hidden' %>><span>abzgl. Vereinsanteil</span><span data-price-club>− <%= h.money(unit.clubCents) %></span></div>
          <div class="pb-print" <%= unit.printCents ? '' : 'hidden' %>><span>+ Persönlicher Druck</span><span data-price-print><%= h.money(unit.printCents) %></span></div>
          <div class="pb-total"><span>Du zahlst im Geschäft <small data-qty-note><%= (values.quantity > 1) ? '(' + values.quantity + ' Stück)' : '' %></small></span><strong data-price-total><%= h.money(unit.memberCents * (Number(values.quantity) || 1)) %></strong></div>
        </div>

        <button class="btn btn-primary btn-lg btn-block" type="submit">In den Warenkorb</button>
        <p class="small muted center">Bezahlung erst bei Abholung im <%= settings.store_name %>.</p>
      </form>

      <% if (product.description) { %>
        <div class="product-description prose">
          <h2>Beschreibung</h2>
          <%- h.markdown(product.description) %>
        </div>
      <% } %>
    </div>
  </div>

  <% if (related.length) { %>
    <section class="related">
      <h2>Passt dazu</h2>
      <div class="product-grid product-grid-small">
        <% related.forEach(function (card) { %><%- include('partials/product-card', { card: card }) %><% }) %>
      </div>
    </section>
  <% } %>
</div>
<%- include('partials/foot') %>
