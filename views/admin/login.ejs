<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Anmelden – Backend <%= settings.store_name %></title>
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body class="admin admin-login-page">
  <form class="card login-card" method="post" action="/admin/login">
    <div class="login-brand">
      <img src="/static/img/store-logo.svg" alt="" width="56" height="56">
      <div><strong><%= settings.store_name %></strong><br><span class="muted">Backend Vereinsshops</span></div>
    </div>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <label class="field">
      <span>Benutzername</span>
      <input name="username" value="<%= username %>" autocomplete="username" required autofocus>
    </label>
    <label class="field">
      <span>Passwort</span>
      <input name="password" type="password" autocomplete="current-password" required>
    </label>
    <button class="btn btn-primary btn-block" type="submit">Anmelden</button>
  </form>
</body>
</html>
