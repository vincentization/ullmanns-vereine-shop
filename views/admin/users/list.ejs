<%- include('../partials/head', { title, active }) %>
<link rel="stylesheet" href="/static/css/admin-catalog.css">

<div class="grid-main-side">
  <section class="card">
    <div class="card-header"><h2>Benutzer mit Zugang zum Backend</h2></div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Benutzer</th><th>Zuletzt angemeldet</th><th></th></tr></thead>
        <tbody>
          <% users.forEach(function (u) { const me = u.id === currentUser.id; %>
            <tr>
              <td>
                <strong><%= u.display_name || u.username %></strong> <% if (me) { %><span class="badge badge-blue">Du</span><% } %>
                <div class="small muted mono"><%= u.username %></div>
              </td>
              <td class="small muted"><%= u.last_login_at ? h.dateTime(u.last_login_at) : 'noch nie' %></td>
              <td class="row-actions">
                <details class="menu">
                  <summary class="btn btn-sm">Bearbeiten</summary>
                  <div class="menu-panel" style="min-width:300px; padding:14px">
                    <form method="post" action="/admin/users/<%= u.id %>/update">
                      <label class="field"><span>Anzeigename</span><input name="display_name" value="<%= u.display_name || '' %>"></label>
                      <% if (me) { %>
                        <label class="field"><span>Aktuelles Passwort</span><input type="password" name="current_password" autocomplete="current-password"><span class="hint">Nur nötig beim Ändern des Passworts.</span></label>
                      <% } %>
                      <label class="field"><span>Neues Passwort</span><input type="password" name="password" autocomplete="new-password" minlength="8"><span class="hint">Leer lassen = unverändert. Mind. 8 Zeichen.</span></label>
                      <label class="field"><span>Neues Passwort wiederholen</span><input type="password" name="password_confirm" autocomplete="new-password"></label>
                      <button class="btn btn-primary btn-sm" type="submit">Speichern</button>
                    </form>
                  </div>
                </details>
                <% if (!me && users.length > 1) { %>
                  <form class="inline" method="post" action="/admin/users/<%= u.id %>/delete" data-confirm="Benutzer &quot;<%= u.username %>&quot; wirklich löschen?">
                    <button class="btn btn-sm btn-danger" type="submit">Löschen</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><h2>Neuer Benutzer</h2></div>
    <form class="card-body" method="post" action="/admin/users">
      <label class="field">
        <span>Benutzername *</span>
        <input name="username" value="<%= form.username || '' %>" class="<%= errors.username ? 'is-invalid' : '' %>" autocomplete="off" required>
        <% if (errors.username) { %><span class="field-error"><%= errors.username %></span><% } %>
      </label>
      <label class="field"><span>Anzeigename</span><input name="display_name" value="<%= form.display_name || '' %>" placeholder="z.B. Eric Gärtner"></label>
      <label class="field">
        <span>Passwort *</span>
        <input type="password" name="password" autocomplete="new-password" class="<%= errors.password ? 'is-invalid' : '' %>" required minlength="8">
        <span class="hint">Mindestens 8 Zeichen.</span>
        <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
      </label>
      <label class="field">
        <span>Passwort wiederholen *</span>
        <input type="password" name="password_confirm" autocomplete="new-password" class="<%= errors.password_confirm ? 'is-invalid' : '' %>" required>
        <% if (errors.password_confirm) { %><span class="field-error"><%= errors.password_confirm %></span><% } %>
      </label>
      <button class="btn btn-primary" type="submit">Benutzer anlegen</button>
      <p class="hint" style="margin-top:12px">Alle Benutzer haben vollen Zugriff auf alle Vereine, Artikel und Bestellungen.</p>
    </form>
  </section>
</div>

<script>
document.addEventListener('click', function (e) {
  document.querySelectorAll('details.menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
});
</script>
<%- include('../partials/foot') %>
